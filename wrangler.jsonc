{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-financeiro",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  // Arquivos de static/ são servidos pela própria Cloudflare; só /api/* passa pelo Worker.
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "controle-financeiro",
      // Troque pelo id real depois de `wrangler d1 create` (Task 9).
      "database_id": "local-dev",
      "migrations_dir": "migrations"
    }
  ]
}
